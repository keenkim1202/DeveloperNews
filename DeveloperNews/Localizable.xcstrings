    "DeveloperNews" : {
      "comment" : "The title of the app.",
      "isCommentAutoGenerated" : true
    },
    "DeveloperNews aggregates publicly available developer content. We display headlines, short excerpts, and links — full articles open in the publisher's website inside the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeveloperNews aggregates publicly available developer content. We display headlines, short excerpts, and links — full articles open in the publisher's website inside the app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeveloperNews는 공개된 개발자 콘텐츠를 수집합니다. 헤드라인, 짧은 발췌, 링크를 표시하며 전체 기사는 앱 내에서 퍼블리셔의 웹사이트에서 열립니다."
          }
        }
      }
    },
    "DeveloperNews collects no personal information. We do not run analytics, telemetry, or any third party tracking SDK that identifies you." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeveloperNews collects no personal information. We do not run analytics, telemetry, or any third party tracking SDK that identifies you."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeveloperNews는 개인 정보를 수집하지 않습니다. 분석, 텔레메트리 또는 사용자를 식별하는 서드파티 추적 SDK를 사용하지 않습니다."
          }
        }
      }
    },
    "DeveloperNews is not responsible for the accuracy, availability, or behavior of third party content surfaced through the app, including any links opened in the in-app browser." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

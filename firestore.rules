rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('followedUserIds', []).size() == 0;

      allow update: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null && request.auth.uid == userId;

      // Activity inbox. Written by whoever performed the action into the
      // recipient's subcollection, and readable only by the recipient.
      match /activities/{activityId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        // The actor writes the row, never to themselves, and never pre-read.
        allow create: if request.auth != null
          && request.auth.uid != userId
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.isRead == false;

        allow update: if request.auth != null && (
          // The recipient may only flip the row to read.
          (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
            && request.resource.data.isRead == true
          )
          // The actor may rewrite their own row, which is how a re-liked post
          // reuses its stable document id instead of stacking a duplicate.
          || (
            request.auth.uid == resource.data.actorId
            && request.resource.data.actorId == request.auth.uid
          )
        );

        // The recipient can dismiss a row; the actor withdraws their own on
        // unlike or unfollow.
        allow delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == resource.data.actorId);
      }
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.likedBy.size() == 0;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            (
              !(request.auth.uid in resource.data.likedBy)
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.likeCount + 1
            )
            || (
              request.auth.uid in resource.data.likedBy
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.likeCount - 1
            )
          )
        )
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount >= 0
          && (
            request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1
            || (
              resource.data.get('commentCount', 0) <= 0
              && request.resource.data.commentCount == 0
            )
          )
        )
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;

        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            ( !(request.auth.uid in resource.data.get('likedBy', []))
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1 )
            || ( request.auth.uid in resource.data.get('likedBy', [])
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1 )
          );

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.authorId;
      }
    }

    match /feedPosts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.likedBy.size() == 0;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            (
              !(request.auth.uid in resource.data.likedBy)
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.likeCount + 1
            )
            || (
              request.auth.uid in resource.data.likedBy
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.likeCount - 1
            )
          )
        )
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount >= 0
          && (
            request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1
            || (
              resource.data.get('commentCount', 0) <= 0
              && request.resource.data.commentCount == 0
            )
          )
        )
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;

        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            ( !(request.auth.uid in resource.data.get('likedBy', []))
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1 )
            || ( request.auth.uid in resource.data.get('likedBy', [])
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1 )
          );

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.authorId;
      }
    }

    match /storyEngagement/{storyId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.likeCount == request.resource.data.likedBy.size()
        && request.resource.data.likeCount <= 1
        && request.resource.data.commentCount >= 0
        && request.resource.data.commentCount <= 1
        && request.resource.data.viewCount >= 0
        && request.resource.data.viewCount <= 1;

      allow update: if request.auth != null && (
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            (
              !(request.auth.uid in resource.data.likedBy)
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.likeCount + 1
            )
            || (
              request.auth.uid in resource.data.likedBy
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.likeCount - 1
            )
          )
        )
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount >= 0
          && (
            request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1
            || (
              resource.data.get('commentCount', 0) <= 0
              && request.resource.data.commentCount == 0
            )
          )
        )
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        )
      );

      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;

        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            ( !(request.auth.uid in resource.data.get('likedBy', []))
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1 )
            || ( request.auth.uid in resource.data.get('likedBy', [])
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1 )
          );

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.authorId;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;

      allow read, delete: if request.auth != null
        && resource.data.reporterId == request.auth.uid;
    }
  }
}

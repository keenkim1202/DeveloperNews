rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('followedUserIds', []).size() == 0;

      allow update: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null && request.auth.uid == userId;

      // Activity inbox. Written by whoever performed the action into the
      // recipient's subcollection, and readable only by the recipient.
      match /activities/{activityId} {
        // A follow points at no post and no comment. A post like points at a
        // post only. Every comment kind points at both.
        function activityShapeIsValid(data) {
          return data.keys().hasOnly([
              'kind', 'actorId', 'preview', 'isRead', 'createdAt',
              'targetCollection', 'targetPostId', 'commentId', 'parentCommentId'])
            && data.keys().hasAll(['kind', 'actorId', 'preview', 'isRead', 'createdAt'])
            && data.kind in ['postLike', 'postComment', 'commentReply', 'commentLike', 'follow']
            && data.actorId is string
            && data.preview is string
            && data.preview.size() <= 140
            && data.isRead is bool
            && (data.kind == 'follow'
              ? !data.keys().hasAny(['targetCollection', 'targetPostId', 'commentId'])
              : (
                data.keys().hasAll(['targetCollection', 'targetPostId'])
                && data.targetCollection in ['posts', 'feedPosts']
                && data.targetPostId is string
                && (data.kind == 'postLike'
                  ? !data.keys().hasAny(['commentId'])
                  : data.commentId is string)
              ))
            // A reply names the comment it answers; nothing else carries one.
            && (data.kind == 'commentReply'
              ? data.parentCommentId is string
              : !data.keys().hasAny(['parentCommentId']));
        }

        function activityPost(data) {
          return get(
            /databases/$(database)/documents/$(data.targetCollection)/$(data.targetPostId)).data;
        }

        function activityComment(data) {
          return get(
            /databases/$(database)/documents/$(data.targetCollection)/$(data.targetPostId)/comments/$(data.commentId)).data;
        }

        // Each kind below is admitted only while the state its notification
        // claims still exists. Without this, `actorId == auth.uid` is the only
        // thing standing between an inbox and an unlimited flood of forged
        // rows about posts the recipient does not own.
        //
        // A missing document makes `get(...)` null and the field read fails,
        // which denies — the outcome we want for a row pointing at nothing.
        // The kind check leads each clause so the reads are skipped for the
        // kinds they do not apply to.
        function isEarnedFollow(data, actor) {
          return data.kind == 'follow'
            && userId in get(
              /databases/$(database)/documents/users/$(actor)).data.get('followedUserIds', []);
        }

        function isEarnedPostLike(data, actor) {
          return data.kind == 'postLike'
            && actor in activityPost(data).get('likedBy', [])
            && activityPost(data).get('authorId', '') == userId;
        }

        function isEarnedPostComment(data, actor) {
          return data.kind == 'postComment'
            && activityComment(data).get('authorId', '') == actor
            && activityPost(data).get('authorId', '') == userId;
        }

        function activityParentComment(data) {
          return get(
            /databases/$(database)/documents/$(data.targetCollection)/$(data.targetPostId)/comments/$(data.parentCommentId)).data;
        }

        // Both halves are checked: the actor wrote the reply, and the reply
        // answers a comment this recipient wrote. The client picks the
        // recipient from the parent it had loaded, so without the second half
        // a reply could be addressed to anyone.
        function isEarnedCommentReply(data, actor) {
          return data.kind == 'commentReply'
            && activityComment(data).get('authorId', '') == actor
            && activityComment(data).get('parentCommentId', '') == data.parentCommentId
            && activityParentComment(data).get('authorId', '') == userId;
        }

        function isEarnedCommentLike(data, actor) {
          return data.kind == 'commentLike'
            && activityComment(data).get('authorId', '') == userId
            && actor in activityComment(data).get('likedBy', []);
        }

        // The document id an activity is required to occupy, derived entirely
        // from its own content and mirroring ActivityDocument.stableId.
        //
        // Proving the action happened is not enough on its own: the evidence
        // stays true after the write, so without pinning the id one real like
        // could be written again under a hundred more ids and bury the
        // recipient's inbox. Pinning it makes an action worth exactly one row.
        function expectedActivityId(data) {
          return data.kind == 'follow'
            ? data.kind + '_' + data.actorId
            : (data.kind == 'postLike'
              ? data.kind + '_' + data.targetCollection + '_' + data.targetPostId
                + '_' + data.actorId
              : data.kind + '_' + data.targetCollection + '_' + data.targetPostId
                + '_' + data.commentId + '_' + data.actorId);
        }

        function activityIsEarned(data, actor) {
          return isEarnedFollow(data, actor)
            || isEarnedPostLike(data, actor)
            || isEarnedPostComment(data, actor)
            || isEarnedCommentReply(data, actor)
            || isEarnedCommentLike(data, actor);
        }

        allow read: if request.auth != null && request.auth.uid == userId;

        // The actor writes the row, never to themselves, and never pre-read.
        allow create: if request.auth != null
          && request.auth.uid != userId
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time
          && activityShapeIsValid(request.resource.data)
          && activityId == expectedActivityId(request.resource.data)
          && activityIsEarned(request.resource.data, request.auth.uid);

        allow update: if request.auth != null && (
          // The recipient may only flip the row to read.
          (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
            && request.resource.data.isRead == true
          )
          // The actor rewrites their own row when a toggle is switched back on,
          // which is how a re-liked post reuses its stable document id instead
          // of stacking a duplicate. It stays a row about the same action by
          // the same actor, and a row the recipient has already read stays
          // read, so re-liking cannot be used to relight the badge.
          || (
            request.auth.uid == resource.data.actorId
            && request.resource.data.actorId == resource.data.actorId
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.isRead == resource.data.isRead
            && request.resource.data.get('targetCollection', '') == resource.data.get('targetCollection', '')
            && request.resource.data.get('targetPostId', '') == resource.data.get('targetPostId', '')
            && request.resource.data.get('commentId', '') == resource.data.get('commentId', '')
            && activityShapeIsValid(request.resource.data)
          )
        );

        // The recipient can dismiss a row; the actor withdraws their own on
        // unlike or unfollow.
        allow delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == resource.data.actorId);
      }
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.likedBy.size() == 0;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            (
              !(request.auth.uid in resource.data.likedBy)
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.likeCount + 1
            )
            || (
              request.auth.uid in resource.data.likedBy
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.likeCount - 1
            )
          )
        )
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount >= 0
          && (
            request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1
            || (
              resource.data.get('commentCount', 0) <= 0
              && request.resource.data.commentCount == 0
            )
          )
        )
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;

        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            ( !(request.auth.uid in resource.data.get('likedBy', []))
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1 )
            || ( request.auth.uid in resource.data.get('likedBy', [])
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1 )
          );

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.authorId;
      }
    }

    match /feedPosts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.likedBy.size() == 0;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            (
              !(request.auth.uid in resource.data.likedBy)
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.likeCount + 1
            )
            || (
              request.auth.uid in resource.data.likedBy
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.likeCount - 1
            )
          )
        )
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount >= 0
          && (
            request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1
            || (
              resource.data.get('commentCount', 0) <= 0
              && request.resource.data.commentCount == 0
            )
          )
        )
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;

        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            ( !(request.auth.uid in resource.data.get('likedBy', []))
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1 )
            || ( request.auth.uid in resource.data.get('likedBy', [])
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1 )
          );

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.authorId;
      }
    }

    match /storyEngagement/{storyId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.likeCount == request.resource.data.likedBy.size()
        && request.resource.data.likeCount <= 1
        && request.resource.data.commentCount >= 0
        && request.resource.data.commentCount <= 1
        && request.resource.data.viewCount >= 0
        && request.resource.data.viewCount <= 1;

      allow update: if request.auth != null && (
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            (
              !(request.auth.uid in resource.data.likedBy)
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.likeCount + 1
            )
            || (
              request.auth.uid in resource.data.likedBy
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.likeCount - 1
            )
          )
        )
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount >= 0
          && (
            request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
            || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1
            || (
              resource.data.get('commentCount', 0) <= 0
              && request.resource.data.commentCount == 0
            )
          )
        )
        || (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        )
      );

      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;

        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && (
            ( !(request.auth.uid in resource.data.get('likedBy', []))
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1 )
            || ( request.auth.uid in resource.data.get('likedBy', [])
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1 )
          );

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.authorId;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;

      allow read, delete: if request.auth != null
        && resource.data.reporterId == request.auth.uid;
    }
  }
}
